# ---------------------------------------------------------------------------
# HIRA GST Audit 360° — environment template. Copy to .env.local (never commit real values).
# ---------------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
APP_URL=http://localhost:3000

# Postgres connection used by the server (Supabase: use the pooled "Transaction" connection string).
# User requests run inside a transaction as role `authenticated` so Row Level Security applies.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hira_gst
# Apply db/local/* (Supabase shim + local auth tables). true ONLY for local/CI databases.
DB_LOCAL_SHIM=true

# Authentication: "supabase" in staging/production, "local" for development and CI.
AUTH_PROVIDER=local
ALLOW_LOCAL_AUTH=false              # must be true to use AUTH_PROVIDER=local when APP_ENV=production
SESSION_SECRET=change-me-to-64-random-hex-characters
SESSION_IDLE_MINUTES=60

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never expose to the browser

# File storage: "supabase" (private bucket audit-files) or "local" (LOCAL_STORAGE_DIR)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
# Optional ClamAV daemon for malware scanning (host:port). Without it uploads are marked scan_status=skipped.
CLAMAV_HOST=

# Background jobs: the worker (npm run worker) or Vercel Cron hitting /api/cron/jobs with this secret
CRON_SECRET=change-me
INLINE_JOBS=true                    # dev convenience: run small jobs immediately after enqueue

# Optional AI assistant ("HIRA GST Intelligence"). Disabled unless configured.
AI_PROVIDER=none                    # none | anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
